// Identifies the GUI executable to Windows (Properties > Details, and
// reputation services): product, publisher, description and version, plus the
// application manifest (asInvoker, Per-Monitor V2 DPI, long paths).
#include <winver.h>
#include <winuser.h>

#define MINIMA_VERSION 1,0,0,0
#define MINIMA_VERSION_TEXT "1.0.0.0"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION MINIMA_VERSION
PRODUCTVERSION MINIMA_VERSION
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "AbdulBasithMohammed"
            VALUE "FileDescription", "MinimaDock taskbar"
            VALUE "FileVersion", MINIMA_VERSION_TEXT
            VALUE "InternalName", "MinimaDock"
            VALUE "LegalCopyright", "Copyright (c) 2026 AbdulBasithMohammed. MIT License."
            VALUE "OriginalFilename", "MinimaDock.exe"
            VALUE "ProductName", "MinimaDock"
            VALUE "ProductVersion", MINIMA_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
